{
  "name": "iointerface",
  "private": true,
  "version": "4.0.0",
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build",
    "bundle": "tauri bundle",
    "app": "tauri build --bundles app",
    "msi": "tauri build --bundles msi",
    "nsis": "tauri build --bundles nsis",
    "win": "tauri build -- --target x86_64-pc-windows-msvc",
    "winarm": "tauri build -- --target aarch64-pc-windows-msvc",
    "createicon": "tauri icon icon.png",
    "machine": "nc -l -k 5001",
    "clean": "node clean.mjs",
    "buildall": "npm i && npm run build",
    "reinstall": "npm run clean && npm run buildall"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.4.0"
  },
  "dependencies": {
    "@tauri-apps/plugin-dialog": "^2.3.2",
    "@tauri-apps/plugin-fs": "^2.4.1",
    "@tauri-apps/plugin-shell": "^2.3.0"
  }
}
