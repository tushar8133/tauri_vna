{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "shell:default",
    {
      "identifier": "dialog:allow-save"
    },
    {
      "identifier": "fs:allow-write-text-file"
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/adb",
          "sidecar": true,
          "args": true
        }
      ]
    }
  ]
}